# Copy to .env only for local development. Do not commit real secrets.

# --- OpenAI (secret in GitHub Actions) ---
OPENAI_API_KEY=
# Global fallback only. Production workflow uses the stage-specific models below.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium

# Cost/quality routing: cheaper Terra for analysis/evidence selection, flagship Sol for final artifacts.
STAGE1_MODEL=gpt-5.6-terra
STAGE2_MODEL=gpt-5.6-terra
STAGE3_MODEL=gpt-5.6-sol
STAGE1_REASONING_EFFORT=low
STAGE2_REASONING_EFFORT=medium
STAGE3_REASONING_EFFORT=medium
STAGE1_MAX_OUTPUT_TOKENS=6000
STAGE2_MAX_OUTPUT_TOKENS=8000
STAGE3_MAX_OUTPUT_TOKENS=24000

# GPT-5.6 prompt caching. 30m is currently the supported minimum TTL.
PROMPT_CACHE_MODE=explicit
PROMPT_CACHE_TTL=30m

# --- Production switch ---
# Leave false until CI + controlled end-to-end testing pass.
AUTOMATION_ENABLED=false
MERGED_ANALYSIS=true

# --- Google OAuth (secrets in GitHub Actions; never commit values) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# GitHub Actions also uses keyless Google Workload Identity Federation.
# Repository variables, not secrets:
# GCP_WORKLOAD_IDENTITY_PROVIDER=projects/597435070079/locations/global/workloadIdentityPools/github-actions/providers/automate-cv-github
# GCP_SERVICE_ACCOUNT=cv-automation@abhishek-cv-automation.iam.gserviceaccount.com

