# Standalone Social service — intentionally excludes Jobs HTML, CV runtime and worker.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json /app/package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY standalone/social_server.js /app/standalone/social_server.js
COPY standalone/social_store.js /app/standalone/social_store.js
COPY standalone/social_research.js /app/standalone/social_research.js
COPY standalone/social.html /app/standalone/social.html
# Only used by the opt-in /social?gmv3=1 prototype. Unflagged /social remains unchanged.
COPY standalone/mobile_hubs.css /app/standalone/mobile_hubs.css
COPY standalone/mobile_collage.css /app/standalone/mobile_collage.css
COPY standalone/assets/nav-collage-states.webp /app/standalone/assets/nav-collage-states.webp
COPY standalone/assets/back-avatar-controls.webp /app/standalone/assets/back-avatar-controls.webp
COPY standalone/mobile_social_hub.js /app/standalone/mobile_social_hub.js
COPY standalone/bridge.js /app/standalone/bridge.js
USER node
ENV PORT=8080
EXPOSE 8080
CMD ["node","standalone/social_server.js"]
