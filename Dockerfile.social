# Standalone Social service — intentionally excludes Jobs HTML, CV runtime and worker.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json /app/package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY standalone/social_server.js /app/standalone/social_server.js
COPY standalone/social_store.js /app/standalone/social_store.js
COPY standalone/social_research.js /app/standalone/social_research.js
COPY standalone/social.html /app/standalone/social.html
# Only used by the opt-in /social?gmv3=1 prototype. Unflagged /social remains unchanged.
COPY standalone/mobile_hubs.css /app/standalone/mobile_hubs.css
COPY standalone/mobile_social_hub.js /app/standalone/mobile_social_hub.js
COPY standalone/mobile_motion_qa.css /app/standalone/mobile_motion_qa.css
COPY standalone/mobile_motion_drawer.js /app/standalone/mobile_motion_drawer.js
COPY standalone/mobile_approved_asset_layer.css /app/standalone/mobile_approved_asset_layer.css
COPY standalone/mobile_editorial_polish.css /app/standalone/mobile_editorial_polish.css
COPY standalone/mobile_stage_visual_qa.css /app/standalone/mobile_stage_visual_qa.css
COPY standalone/mobile_design_language.css /app/standalone/mobile_design_language.css
# Five-second opening films for opt-in Social QA only. No Jobs runtime included.
COPY standalone/mobile_intro_overlay.html /app/standalone/mobile_intro_overlay.html
COPY standalone/mobile_intro_overlay.css /app/standalone/mobile_intro_overlay.css
COPY standalone/mobile_intro_overlay.js /app/standalone/mobile_intro_overlay.js
COPY standalone/assets/garamaal-intro-mobile.mp4 /app/standalone/assets/garamaal-intro-mobile.mp4
COPY standalone/assets/garamaal-intro-desktop.mp4 /app/standalone/assets/garamaal-intro-desktop.mp4
COPY standalone/assets/navigation-states.css /app/standalone/assets/navigation-states.css
COPY standalone/assets/header-controls.css /app/standalone/assets/header-controls.css
COPY standalone/bridge.js /app/standalone/bridge.js
USER node
ENV PORT=8080
EXPOSE 8080
CMD ["node","standalone/social_server.js"]
