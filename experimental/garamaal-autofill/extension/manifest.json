{
    "manifest_version":  3,
    "name":  "Garamaal Autofill (MVP)",
    "version":  "0.4.1",
    "description":  "Current-page job application autofill; never navigates or submits",
    "permissions":  [
                        "activeTab",
                        "scripting",
                        "storage",
                        "sidePanel"
                    ],
    "action":  {
                   "default_title":  "Garamaal Autofill"
               },
    "host_permissions":  [
                             "http://127.0.0.1:8766/*",
                             "https://garamaal.web.app/*",
                             "https://blackrock.tal.net/*",
                             "https://app.spott.io/*"
                         ],
    "side_panel":  {
                       "default_path":  "popup.html"
                   },
    "background":  {
                       "service_worker":  "background.js"
                   }
}
