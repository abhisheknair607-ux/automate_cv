FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --chown=node:node package.json ./
RUN npm install --omit=dev --no-fund --no-audit
# Frozen, QA-tested standalone webapp. Never overwrite the Python worker's webapp/ files.
COPY --chown=node:node garamaal-release-webapp ./webapp
COPY --chown=node:node standalone ./standalone
ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080
# Cloud Shell private build directories may copy source as mode 0600/0700.
# The unprivileged runtime must own copied application files to read them.
USER node
CMD ["node","standalone/server.js"]
